# PRAMANA backend environment configuration
# Copy this file to .env and adjust values before running.
# NEVER commit a real .env file with production secrets.

PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API with credentials.
CORS_ORIGIN=http://localhost:5173

# Generate a long random string for production, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-in-production
SESSION_TTL_HOURS=12

# SQLite file path (default: backend/data/pramana.sqlite)
DATABASE_PATH=./data/pramana.sqlite

# Administrator account seeding (first run only, when the users table is empty).
# The public portal has no accounts — every public page is open without signing in.
# CHANGE THESE before exposing the application beyond your local machine.
SEED_ADMIN_EMAIL=admin@pramana.local
SEED_ADMIN_PASSWORD="ChangeMe#Admin123"

# ---------------------------------------------------------------------------
# PRAMANA AI (optional)
# PRAMANA AI answers strictly from the loaded datasets. Without a key it uses the
# built-in data query engine — comparisons included — so the feature works offline.
#
# The normal way to add a key is Admin -> AI Configuration in the running
# application: the key is stored encrypted in the database, never reaches the
# browser, and can be replaced or tested from that screen. These variables are only
# a fallback for automated deployment, and a key saved from the admin screen takes
# precedence over them.
#
# The provider is detected from the key's prefix:
#   AIza...       Google AI Studio -> https://aistudio.google.com/apikey
#                 defaults to gemini-2.0-flash, which is served on the free tier
#   sk-proj-...   OpenAI           -> https://platform.openai.com/api-keys
#                 defaults to gpt-4o-mini
#   nvapi-...     NVIDIA           -> Kimi K2 via NVIDIA's OpenAI-compatible endpoint
#   sk-...        Moonshot         -> https://platform.moonshot.ai
#
# Leave blank unless you are deploying without access to the admin screen.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Any one of these is used, in this order. Leave the others blank.
OPENAI_API_KEY=
KIMI_API_KEY=
# Base URL and model are chosen automatically from the key unless set here.
KIMI_BASE_URL=
KIMI_MODEL=
